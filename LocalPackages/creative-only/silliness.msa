/chickenhead = >>>
	foreach (@p in all_players()) {
		set_entity_rider(pinfo(@p, 13), spawn_entity('chicken')[0]);
	}
<<<

*:/uwot = msg(color('red').'==='.color('white').'M8'.color('red').'===');

*:/spoon = msg('Forks are better');

/**
 * @command
 * @permission nerdch.level.admin
 */
*:/supavanish [$mob='chicken'] = >>>
	_assertperm('admin', 0);
	assign(@pcursor, pcursor(player()));
	lightning(array(array_get(@pcursor, 0), 0, array_get(@pcursor, 2)));
	run('/adminmode')
	spawn_entity($mob)
<<<
