// For fun commands that don't really fit anywhere else.

// Aliases for the normal things players scream when a restart is near.


/**
 * @command
 */
*:/pants = >>>
        run_cmd('/nextrestart')
<<<

/**
 * @command
 */
*:/replant = >>>
        run_cmd('/nextrestart')
<<<

/**
 * @command
 */
*:/repant = >>>
        run_cmd('/nextrestart')
<<<

/**
 * @command
 */
*:/repent = >>>
        run_cmd('/nextrestart')
<<<
